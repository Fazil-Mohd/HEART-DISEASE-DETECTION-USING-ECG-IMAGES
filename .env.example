# .env.example — copy this file to .env and fill in your real values
# The .env file is gitignored — never commit it.
#
# Usage:
#   Windows: set each variable in your terminal session, OR
#   use a tool like python-dotenv to load the .env file automatically.

# Django
DJANGO_SECRET_KEY=django-insecure-local-dev-key-replace-me
DJANGO_DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost

# Database — leave blank to use SQLite locally
DATABASE_URL=

# Redis — default local Redis
REDIS_URL=redis://127.0.0.1:6379/0

# Email — your Gmail address + App Password
EMAIL_HOST_USER=yourname@gmail.com
EMAIL_HOST_PASSWORD=your-16-char-app-password

# Hugging Face model (only needed in production / testing download locally)
HF_MODEL_REPO=your-hf-username/ecg-resnet50
HF_MODEL_FILENAME=resnet50_ecg_best.keras
# HF_TOKEN=hf_xxxxxxxxxxxx   # uncomment if your HF repo is private
